<div class="scene" aria-hidden="true">
  <svg viewBox="0 0 200 300">
    <defs>
      <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" class="sky-top"></stop>
        <stop offset="1" class="sky-bottom"></stop>
      </linearGradient>
      <clipPath id="envelope"><path d="<%= ENVELOPE %>"></path></clipPath>
      <clipPath id="scene-edge"><rect width="200" height="300" rx="16"></rect></clipPath>
    </defs>
    <g clip-path="url(#scene-edge)">
      <rect width="200" height="300" fill="url(#sky)"></rect>
      <circle class="sun" cx="164" cy="44" r="16"></circle>
      <g class="cloud" transform="translate(18 92)">
        <circle cx="12" cy="8" r="10"></circle><circle cx="26" cy="2" r="13"></circle><circle cx="40" cy="9" r="9"></circle>
        <rect x="12" y="8" width="28" height="10"></rect>
      </g>
      <g class="cloud" transform="translate(128 170) scale(0.8)">
        <circle cx="12" cy="8" r="10"></circle><circle cx="26" cy="2" r="13"></circle><circle cx="40" cy="9" r="9"></circle>
        <rect x="12" y="8" width="28" height="10"></rect>
      </g>
      <path class="birds" d="M40 60 q5 -5 10 0 q5 -5 10 0 M66 44 q4 -4 8 0 q4 -4 8 0 M150 90 q4 -4 8 0 q4 -4 8 0"></path>
      <g class="balloon">
        <g class="bob">
          <g clip-path="url(#envelope)">
            <rect class="stripe-a" x="50" y="14" width="100" height="104"></rect>
            <rect class="stripe-b" x="67" y="14" width="22" height="104"></rect>
            <rect class="stripe-b" x="111" y="14" width="22" height="104"></rect>
            <rect class="stripe-c" x="89" y="14" width="22" height="104"></rect>
          </g>
          <path class="outline" d="<%= ENVELOPE %>"></path>
          <path class="flame" d="M100 131 C95 127 96 122 100 118 C104 122 105 127 100 131 Z"></path>
          <path class="rope" d="M89 118 L92 138 M111 118 L108 138"></path>
          <circle class="person" cx="100" cy="135" r="4.5"></circle>
          <rect class="basket" x="90" y="138" width="20" height="14" rx="3"></rect>
        </g>
      </g>
      <path class="sea" d="M0 266 Q12.5 259 25 266 T50 266 T75 266 T100 266 T125 266 T150 266 T175 266 T200 266 V300 H0 Z"></path>
      <path class="splash" d="M84 258 q-6 -14 -16 -12 M116 258 q6 -14 16 -12 M100 252 v-14"></path>
    </g>
  </svg>
</div>
